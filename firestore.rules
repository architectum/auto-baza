rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Car Validation
    function isValidCar(data) {
      return data.keys().hasAll(['plate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.plate is string && data.plate.size() <= 64
        && data.ownerId == request.auth.uid
        && data.createdAt is string
        && data.updatedAt is string
        && data.get('make', '') is string
        && data.get('model', '') is string
        && data.get('year', 0) is number
        && data.get('mileage', 0) is number
        && data.get('color', '') is string
        && data.get('bodyType', '') is string
        && data.get('clientName', '') is string
        && data.get('clientPhone', '') is string
        && data.get('note', '') is string
        && data.get('photoUrl', '') is string
        && data.get('photoPath', '') is string
        && data.get('avatarUrl', '') is string
        && data.get('avatarPath', '') is string;
    }

    // History Validation
    function isValidHistory(data) {
      return data.keys().hasAll(['type', 'authorId', 'createdAt'])
        && data.type is string && data.type in ['problem', 'solution', 'note', 'mileage', 'reminder']
        && data.authorId == request.auth.uid
        && data.createdAt is string
        && data.get('text', '') is string
        && data.get('runtimeMileage', 0) is number
        && data.get('mileageDiff', 0) is number
        && data.get('photoUrl', '') is string
        && data.get('photoPath', '') is string
        && data.get('cost', 0) is number
        && data.get('spentHours', 0) is number
        && data.get('linkedSolutionId', '') is string
        && data.get('fileUrls', []) is list
        && data.get('filePaths', []) is list
        && data.get('reminderDate', '') is string
        && data.get('reminderTime', '') is string
        && data.get('reminderStatus', 'pending') is string
        && (data.get('reminderRecurrence', '') == null || data.get('reminderRecurrence', '') is string);
    }

    match /cars/{carId} {
      // Only the owner can read cars
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      // Any authenticated user can create a car (auto-generated ID)
      allow create: if isSignedIn() 
        && isValidCar(incoming());
        
      // Only the owner can update
      allow update: if isSignedIn()
        && isValidCar(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().createdAt == existing().createdAt;
        
      // Only the owner can delete
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      match /history/{historyId} {
        // Only the owner of the car can read its history
        allow get: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;

        // Any authenticated user who owns the car can create history
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid
          && isValidHistory(incoming());
          
        // Owner can update history entries (edit type, text, mileage)
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid
          && isValidHistory(incoming())
          && incoming().authorId == existing().authorId
          && (existing().type == 'mileage' ? incoming().createdAt == existing().createdAt : true);
          
        // Owner can delete history entries
        allow delete: if isSignedIn() 
          && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;
      }

      match /files/{fileId} {
        allow read, write: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if true;
    }
  }
}
