rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Car Validation
    function isValidCar(data) {
      return data.keys().hasAll(['plate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.plate is string && data.plate.size() > 0 && data.plate.size() <= 64
        && data.ownerId == request.auth.uid
        && data.createdAt is string
        && data.updatedAt is string
        && data.get('make', '') is string
        && data.get('model', '') is string
        && data.get('year', 0) is number
        && data.get('mileage', 0) is number
        && data.get('color', '') is string
        && data.get('bodyType', '') is string
        && data.get('clientName', '') is string
        && data.get('clientPhone', '') is string
        && data.get('note', '') is string;
    }

    // History Validation
    function isValidHistory(data) {
      return data.keys().hasAll(['type', 'authorId', 'createdAt'])
        && data.type is string && data.type in ['problem', 'solution', 'note', 'mileage']
        && data.authorId == request.auth.uid
        && data.createdAt is string
        && data.get('text', '') is string
        && data.get('runtimeMileage', 0) is number
        && data.get('mileageDiff', 0) is number;
    }

    match /cars/{carId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      
      allow create: if isSignedIn() 
        && isValidId(carId)
        && isValidCar(incoming())
        && incoming().plate == carId;
        
      allow update: if isSignedIn()
        && isValidCar(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().plate == existing().plate
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['make', 'model', 'year', 'mileage', 'color', 'bodyType', 'clientName', 'clientPhone', 'note', 'updatedAt']);
        
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      match /history/{historyId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(historyId)
          && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid
          && isValidHistory(incoming());
          
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid
          && isValidHistory(incoming())
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().type == existing().type
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'runtimeMileage', 'mileageDiff']);
          
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
